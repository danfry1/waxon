Output demo/recordings/cli.gif
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 14
Set Width 1200
Set Height 620
Set TypingSpeed 60ms
Set Theme "Ayu Mirage"

Hide
Type "alias waxon='./waxon-demo demo'; clear"
Enter
Show

Type "waxon status"
Enter
Sleep 1.2s
Type "waxon status --json"
Enter
Sleep 1.5s
Type "waxon status --format '{icon} {title} [{position}/{duration}] vol {volume}% on {device}'"
Enter
Sleep 1.5s
Type "waxon devices"
Enter
Sleep 1.2s
Type "waxon search daft punk"
Enter
Sleep 1.5s
Type "waxon play get lucky"
Enter
Sleep 1.2s
Type "waxon vol +5"
Enter
Sleep 1s
Type "waxon like"
Enter
Sleep 2.5s
