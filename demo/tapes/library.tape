Output demo/recordings/library.gif
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 13
Set Width 1400
Set Height 800
Set TypingSpeed 80ms
Set Theme "Ayu Mirage"

Hide
Type "./waxon-demo demo"
Enter
Sleep 2s
Show

# Saved Albums sits under Liked Songs
Type "j"
Sleep 500ms
Enter
Sleep 1.5s

# Browse, then open an album
Type "l"
Sleep 300ms
Type "jj"
Sleep 600ms
Enter
Sleep 2s
Backspace
Sleep 1s

# Filter the albums by artist
Type "l"
Sleep 300ms
Type "/"
Sleep 300ms
Type "tame"
Sleep 1.5s
Escape
Sleep 600ms

# Followed Artists, then open one
Type "h"
Sleep 300ms
Type "j"
Sleep 500ms
Enter
Sleep 1.5s
Type "l"
Sleep 300ms
Type "jjjjjjj"
Sleep 600ms
Enter
Sleep 2.5s
