Output demo/recordings/playlists.gif
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 13
Set Width 1400
Set Height 800
Set TypingSpeed 70ms
Set Theme "Ayu Mirage"

Hide
Type "./waxon-demo demo"
Enter
Sleep 2s
Show

# Pick a track and add it to a playlist
Type "l"
Sleep 500ms
Type "jjjj"
Sleep 600ms
Type "o"
Sleep 1.2s
Type "jjj"
Sleep 800ms
Enter
Sleep 1.2s
Type "cod"
Sleep 1s
Enter
Sleep 2s

# Create a new playlist from command mode
Type ":playlist new Road Trip"
Sleep 800ms
Enter
Sleep 2.5s
