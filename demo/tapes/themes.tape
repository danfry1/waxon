Output demo/recordings/themes.gif
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 13
Set Width 1400
Set Height 800
Set TypingSpeed 60ms
Set Theme "Ayu Mirage"

Hide
Type "./waxon-demo demo"
Enter
Sleep 2s
Show

Type "l"
Sleep 1s
Type ":theme catppuccin-mocha"
Enter
Sleep 1.8s
Type ":theme gruvbox"
Enter
Sleep 1.8s
Type ":theme tokyonight"
Enter
Sleep 1.8s
Type ":theme rose-pine"
Enter
Sleep 1.8s
Type ":theme spotify"
Enter
Sleep 1.5s
