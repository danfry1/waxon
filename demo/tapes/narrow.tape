Output demo/recordings/narrow.gif
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 14
Set Width 640
Set Height 560
Set TypingSpeed 80ms
Set Theme "Ayu Mirage"

Hide
Type "./waxon-demo demo"
Enter
Sleep 2s
Show

# Narrow terminal: one pane at a time, h/l switch between them
Sleep 1.5s
Type "l"
Sleep 1.5s
Type "jjj"
Sleep 800ms
Enter
Sleep 1.5s
Type "h"
Sleep 1.2s
Type "j"
Sleep 500ms
Enter
Sleep 1.5s
Type "N"
Sleep 2.5s
Type "N"
Sleep 1s
