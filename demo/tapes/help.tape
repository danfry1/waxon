Output demo/recordings/help.gif
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 13
Set Width 1400
Set Height 800
Set TypingSpeed 80ms
Set Theme "Ayu Mirage"

Hide
Type "./waxon-demo demo"
Enter
Sleep 2s
Show

# Help overlay, generated from the live keymap
Type "?"
Sleep 3s
Type "q"
Sleep 800ms

# Search: no results is now distinguishable from "still searching"
Type "s"
Sleep 500ms
Type "zzqxv"
Sleep 2s
Escape
Sleep 1s
